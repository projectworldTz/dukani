APP_NAME=Dukani
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seeded on `php artisan migrate --seed` — the Platform Admin (SaaS-level) account,
# not a business user. Change PLATFORM_ADMIN_PASSWORD before deploying anywhere real.
PLATFORM_ADMIN_NAME="Platform Admin"
PLATFORM_ADMIN_EMAIL=admin@dukani.test
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Minutes a Sanctum API token stays valid before it must be reissued via login.
# Defaults to 14 days if unset.
# SANCTUM_TOKEN_EXPIRATION_MINUTES=20160

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dukani
DB_USERNAME=dukani
DB_PASSWORD=dukani

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set MAIL_MAILER=brevo to send via Brevo's HTTP API instead of SMTP (see the
# 'brevo' entry in config/mail.php) -- needed on hosts that intercept outbound SMTP
# on every port, such as Truehost. Get the key from Brevo's dashboard under
# Settings -> SMTP & API -> API Keys (not the SMTP tab).
# BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Approved EFD/VFD middleware endpoint. Do not enable EFD in Business Settings until
# your TRA-certified provider has supplied these credentials.
EFD_GATEWAY_URL=
EFD_GATEWAY_TOKEN=
EFD_GATEWAY_TIMEOUT=15

# --- Free trial, new-client alerts and subscription contact -------------------
# Every new business gets TRIAL_DAYS free; it then locks until you extend its
# license in Platform Admin ("Mark paid").
TRIAL_DAYS=14
# SMS to the client this many days after registering, asking them to subscribe.
# Needs the scheduler: add ONE cPanel cron job running every minute:
#   cd /home/USER/path/to/dukani/backend && php artisan schedule:run >> /dev/null 2>&1
TRIAL_REMINDER_AFTER_DAYS=2
# Who is told about every new registration (comma-separated).
NEW_CLIENT_ALERT_EMAILS=you@example.com
NEW_CLIENT_ALERT_PHONES=0712345678
# Shown to clients on the trial banner and the "trial ended" screen.
SUBSCRIPTION_CONTACT_NAME="Dukani Sales"
SUBSCRIPTION_CONTACT_PHONE="0712 345 678"
SUBSCRIPTION_CONTACT_WHATSAPP="0712 345 678"
SUBSCRIPTION_CONTACT_EMAIL=sales@example.com
SUBSCRIPTION_PAYMENT_INFO="M-Pesa Lipa Namba 123456 - YOUR NAME"

# SMS gateway: log (no SMS, written to the log), beem, nextsms or africastalking.
# SMS_SENDER_ID must be a sender name approved by your provider.
SMS_DRIVER=log
SMS_SENDER_ID=INFO
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# NEXTSMS_USERNAME=
# NEXTSMS_PASSWORD=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
